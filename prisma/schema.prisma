  @@index([serviceCodes], type: Gin, map: "firm_search_service_codes_gin")
  @@index([assetCategoryCodes], type: Gin, map: "firm_search_asset_category_codes_gin")
  @@index([custodianIds], type: Gin, map: "firm_search_custodian_ids_gin")
  @@index([fundTypeCodes], type: Gin, map: "firm_search_fund_type_codes_gin")
  @@index([affiliatedCrds], type: Gin, map: "firm_search_affiliated_crds_gin")
  @@index([socialPlatforms], type: Gin, map: "firm_search_social_platforms_gin")
  @@index([advisorCount(sort: Desc)])
  @@index([netAdvisorFlow90d(sort: Desc)])
  @@schema("market")
  @@map("firm_search")
}

/**
 * workspace_id is the tenancy key on every app table. It becomes a FK to
 * better-auth's organization.id in phase 06 — one organization is one
 * workspace. The column keeps the product word so a later org 1-N workspace
 * split repoints the FK instead of renaming 21 columns.
 */

// ─────────────────────────── app · auth (better-auth) ───────────────────────
//
// Generated by `@better-auth/cli generate`, then hand-annotated with @map /
// @@map / @@schema. Re-running the CLI emits camelCase defaults and DROPS these
// annotations — re-apply them, do not paste the output over this block.
//
// Organization IS the workspace. Every app table's workspace_id refers to
// organization.id; session.activeOrganizationId is where it comes from.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  accounts    Account[]
  teamMembers TeamMember[]
  members     Member[]
  invitations Invitation[]

  @@schema("app")
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  /// the active workspace — read into ALS by SessionGuard, never from a header
  activeOrganizationId String?  @map("active_organization_id")
  activeTeamId         String?  @map("active_team_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("app")
  @@map("session")
}

model Account {
  id                    String    @id
  /// better-auth 1.7 writes this; its own CLI does not emit it
  issuer                String?
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("app")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@schema("app")
  @@map("verification")
}

/// the workspace / tenant. app.workspace_id points here.
model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teams       Team[]
  members     Member[]
  invitations Invitation[]

  /// every app table's workspace_id points here — one organization is one workspace
  entitys Entity[]
  entityAttributes EntityAttribute[]
  entityAttributeChoices EntityAttributeChoice[]
  entityRecords EntityRecord[]
  entityRecordValues EntityRecordValue[]
  entityRecordRelationships EntityRecordRelationship[]
  entityViews EntityView[]
  entityViewFields EntityViewField[]
  entityViewFieldPaths EntityViewFieldPath[]
  lists List[]
  listMembers ListMember[]

  @@schema("app")
  @@map("organization")
}

/// a sub-unit within a workspace — never repurposed as a tenant boundary
model Team {
  id             String    @id
  name           String
  memberCount    Int       @default(0) @map("member_count")
  organizationId String    @map("organization_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMembers  TeamMember[]

  @@index([organizationId])
  @@schema("app")
  @@map("team")
}

model TeamMember {
  id            String    @id
  teamId        String    @map("team_id")
  userId        String    @map("user_id")
  membershipKey String?   @unique @map("membership_key")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
  @@schema("app")
  @@map("team_member")
}

/// membership of an organization — not repurposed for anything else
model Member {
  id             String   @id
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@schema("app")
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String   @map("organization_id")
  email          String
  role           String?
  teamId         String?  @map("team_id")
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  inviterId      String   @map("inviter_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@schema("app")
  @@map("invitation")
}

// ────────────────────────── app · EAV substrate ─────────────────────────
//
// User-authored columns only. SEC data is NOT stored here — it is projected
// from market via reference attributes. 510k advisors x ~170 reference fields
// as cells would be ~87M rows per tenant, duplicating data identical for
// every tenant. See docs/plans/07-eav-and-grid.md.

enum AttributeType {
  text
  number
  checkbox
  currency
  date
  timestamp
  rating
  status
  select
  record
  relationship
  user
  location
  domain
  email
  phone
  url
  boolean
  percentage
  country
  file

  @@schema("app")
  @@map("attribute_type")
}

enum AttributeRelationshipType {
  oneToOne
  oneToMany
  manyToOne
  manyToMany

  @@schema("app")
  @@map("attribute_relationship_type")
}

/// records who set a cell. NULL = user. Lets an enrichment refresh overwrite
/// its own prior writes without clobbering a manual edit.
enum CellSource {
  enrichment
  import
  ai

  @@schema("app")
  @@map("cell_source")
}

enum ViewType {
  table
  pipeline

  @@schema("app")
  @@map("view_type")
}

enum SourceKind {
  advisor
  firm

  @@schema("app")
  @@map("source_kind")
}

/// A table definition. Entity owns the attribute schema; List owns membership.
model Entity {
  id                 String   @id @default(uuid(7))
  workspaceId        String   @map("workspace_id")
  name               String
  singularNoun       String?  @map("singular_noun")
  slug               String
  icon               String?
  color              String?
  /// advisor | firm when this entity mirrors market data
  sourceKind         SourceKind? @map("source_kind")
  primaryAttributeId String?  @map("primary_attribute_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  attributes EntityAttribute[]
  records    EntityRecord[]
  views      EntityView[]

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([slug, workspaceId])
  @@index([workspaceId])
  @@schema("app")
  @@map("entity")
}

/// A field definition. Three kinds, distinguished by how the grid resolves them:
///   eav          — a cell in entity_record_value
///   relationship — an edge in entity_record_relationship
///   reference    — a column in a market projection, resolved by JOIN, never copied
model EntityAttribute {
  id          String        @id @default(uuid(7))
  entityId    String        @map("entity_id")
  workspaceId String        @map("workspace_id")
  label       String
  key         String
  type        AttributeType
  description String?
  /// lexorank
  position    String
  defaultValue Json?        @map("default_value") @db.JsonB

  isUnique        Boolean @default(false) @map("is_unique")
  isSystem        Boolean @default(false) @map("is_system")
  isPrimary       Boolean @default(false) @map("is_primary")
  isRequired      Boolean @default(false) @map("is_required")
  isEditable      Boolean @default(true) @map("is_editable")
  isArchived      Boolean @default(false) @map("is_archived")
  isMultiValue    Boolean @default(false) @map("is_multi_value")

  /// set for reference attributes: the market projection column this resolves to.
  /// Validated against an allowlist at compile time — identifiers never come
  /// from user input.
  referenceColumn String? @map("reference_column")

  relationshipType                AttributeRelationshipType? @map("relationship_type")
  /// which side of a relationship pair owns the canonical edge row
  isCanonicalSide                 Boolean?                   @map("is_canonical_side")
  otherRelationshipSideAttributeId String?                   @unique @map("other_relationship_side_attribute_id")
  relationEntityId                String?                    @map("relation_entity_id")

  /// per-type config blob, validated on write by the attribute-type registry
  config Json @default("{}") @db.JsonB

  /// panel grouping on the record page, e.g. "Pipeline" | "Current firm".
  /// Presentation only — the grid's column set lives in entity_view_field.
  group String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  entity        Entity                  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  choices       EntityAttributeChoice[]
  values        EntityRecordValue[]
  relationships EntityRecordRelationship[]
  viewPaths     EntityViewFieldPath[]

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([entityId, key])
  @@index([workspaceId, entityId])
  @@index([referenceColumn])
  @@schema("app")
  @@map("entity_attribute")
}

/// Unified labelled choices for status/select attributes. isWon/isLost carry
/// pipeline semantics.
model EntityAttributeChoice {
  id          String  @id @default(uuid(7))
  attributeId String  @map("attribute_id")
  workspaceId String  @map("workspace_id")
  name        String
  color       String?
  position    Int
  isWon       Boolean @default(false) @map("is_won")
  isLost      Boolean @default(false) @map("is_lost")
  metadata    Json    @default("{}") @db.JsonB

  attribute EntityAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([attributeId, position])
  @@index([workspaceId])
  @@schema("app")
  @@map("entity_attribute_choice")
}

/// A row. Points at market by CRD value — never by FK, and never at the firm
/// an advisor works for, so a firm change is invisible here.
model EntityRecord {
  id          String      @id @default(uuid(7))
  entityId    String      @map("entity_id")
  workspaceId String      @map("workspace_id")
  sourceKind  SourceKind? @map("source_kind")
  sourceCrd   BigInt?     @map("source_crd")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  entity        Entity                     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  values        EntityRecordValue[]
  outgoingEdges EntityRecordRelationship[] @relation("SourceRecord")
  incomingEdges EntityRecordRelationship[] @relation("TargetRecord")
  listMembers   ListMember[]

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([entityId, sourceKind, sourceCrd, workspaceId])
  @@index([entityId, workspaceId])
  @@index([sourceKind, sourceCrd])
  @@schema("app")
  @@map("entity_record")
}

/// EAV cell storage: one row per (record, attribute), one typed column
/// populated per row, dispatched by attribute.type. The per-type composite
/// indexes are what make EAV filtering fast rather than pathological.
model EntityRecordValue {
  id          String      @id @default(uuid(7))
  recordId    String      @map("record_id")
  attributeId String      @map("attribute_id")
  workspaceId String      @map("workspace_id")

  textValue    String?  @map("text_value")
  numericValue Decimal? @map("numeric_value") @db.Decimal(30, 10)
  dateValue    DateTime? @map("date_value") @db.Timestamptz(6)
  booleanValue Boolean? @map("boolean_value")
  jsonValue    Json?    @map("json_value") @db.JsonB

  /// optimistic concurrency token
  version Int         @default(0)
  source  CellSource?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  record    EntityRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  attribute EntityAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([recordId, attributeId])
  @@index([attributeId, numericValue])
  @@index([attributeId, textValue])
  @@index([attributeId, dateValue])
  @@index([attributeId, booleanValue])
  @@index([recordId])
  @@index([workspaceId, attributeId])
  @@schema("app")
  @@map("entity_record_value")
}

/// Edges are written and read on the canonical side only; the non-canonical
/// side dispatches through otherRelationshipSideAttributeId.
model EntityRecordRelationship {
  id             String @id @default(uuid(7))
  sourceRecordId String @map("source_record_id")
  targetRecordId String @map("target_record_id")
  attributeId    String @map("attribute_id")
  workspaceId    String @map("workspace_id")

  relationshipType AttributeRelationshipType? @map("relationship_type")
  metadata         Json                       @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  source    EntityRecord    @relation("SourceRecord", fields: [sourceRecordId], references: [id], onDelete: Cascade)
  target    EntityRecord    @relation("TargetRecord", fields: [targetRecordId], references: [id], onDelete: Cascade)
  attribute EntityAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([sourceRecordId, attributeId, targetRecordId])
  @@index([sourceRecordId, attributeId])
  @@index([targetRecordId])
  @@schema("app")
  @@map("entity_record_relationship")
}

/// A saved view: filter AST, sort AST and column configuration.
model EntityView {
  id          String   @id @default(uuid(7))
  entityId    String   @map("entity_id")
  workspaceId String   @map("workspace_id")
  userId      String?  @map("user_id")
  name        String
  type        ViewType @default(table)
  isDefault   Boolean  @default(false) @map("is_default")

  /// filter ast (and|or|not|condition); compiled to parameterized sql at query time
  filterTree Json? @map("filter_tree") @db.JsonB
  /// multi-column sort: [{ path, direction }]
  sort       Json? @db.JsonB

  pipelineGroupById String? @map("pipeline_group_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  entity Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  fields EntityViewField[]

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([entityId, workspaceId])
  @@schema("app")
  @@map("entity_view")
}

model EntityViewField {
  id          String  @id @default(uuid(7))
  viewId      String  @map("view_id")
  workspaceId String  @map("workspace_id")
  label       String?
  /// lexorank
  position    String
  width       Int?
  aggregate   String?
  isVisible   Boolean @default(true) @map("is_visible")
  isPinned    Boolean @default(false) @map("is_pinned")
  /// excluded from the page query and fetched on demand by the cell renderer
  lazy        Boolean @default(false)

  view  EntityView            @relation(fields: [viewId], references: [id], onDelete: Cascade)
  paths EntityViewFieldPath[]

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([viewId])
  @@schema("app")
  @@map("entity_view_field")
}

/// Ordered hops enabling lookup columns through relationships, max 3.
model EntityViewFieldPath {
  fieldId     String @map("field_id")
  position    Int
  attributeId String @map("attribute_id")
  workspaceId String @map("workspace_id")

  field     EntityViewField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  attribute EntityAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([fieldId, position])
  @@index([attributeId])
  @@schema("app")
  @@map("entity_view_field_path")
}

// ───────────────────────────── app · lists ──────────────────────────────

enum ListKind {
  static
  dynamic

  @@schema("app")
  @@map("list_kind")
}

/// Entity owns the schema; List owns membership. A record in two lists has ONE
/// set of cells — the legacy model gave each list private columns, so setting
/// a value in one left the other empty.
model List {
  id            String   @id @default(uuid(7))
  workspaceId   String   @map("workspace_id")
  userId        String   @map("user_id")
  entityId      String   @map("entity_id")
  name          String
  kind          ListKind @default(static)
  /// dynamic lists only: the filter AST defining membership
  filterTree    Json?    @map("filter_tree") @db.JsonB
  defaultViewId String?  @map("default_view_id")
  /// workspace | private
  visibility    String   @default("workspace")
  deletedAt     DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  members ListMember[]

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityId])
  @@schema("app")
  @@map("list")
}

model ListMember {
  listId        String   @map("list_id")
  recordId      String   @map("record_id")
  workspaceId   String   @map("workspace_id")
  addedAt       DateTime @default(now()) @map("added_at")
  addedByUserId String?  @map("added_by_user_id")

  list   List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  record EntityRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([listId, recordId])
  @@index([recordId])
  @@index([workspaceId])
  @@schema("app")
  @@map("list_member")
}
