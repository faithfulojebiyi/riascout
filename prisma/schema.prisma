  aumPerAdvisor           Decimal? @map("aum_per_advisor") @db.Decimal(20, 2)
  aumPerClient            Decimal? @map("aum_per_client") @db.Decimal(20, 2)
  aumPerEmployee          Decimal? @map("aum_per_employee") @db.Decimal(20, 2)
  aumPercentile           Int?     @map("aum_percentile")
  aumPerAdvisorPercentile Int?     @map("aum_per_advisor_percentile")

  aumCagr1y      Decimal? @map("aum_cagr_1y") @db.Decimal(12, 6)
  aumCagr3y      Decimal? @map("aum_cagr_3y") @db.Decimal(12, 6)
  aumCagr5y      Decimal? @map("aum_cagr_5y") @db.Decimal(12, 6)
  employeeCagr3y Decimal? @map("employee_cagr_3y") @db.Decimal(12, 6)

  clientTypeCodes    String[] @map("client_type_codes")
  serviceCodes       String[] @map("service_codes")
