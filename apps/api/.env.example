NODE_ENV=development
PORT=3320
API_PREFIX=

# comma-separated. credentialed cors allowlist — never a wildcard
TRUSTED_ORIGINS=http://localhost:3020

# the compose database from `bun run infra:up`. ?schema=app so prisma's
# default and raw-query default land in the app schema
APP_DATABASE_URL=postgresql://riascout:riascout@localhost:5442/riascout?schema=app
# APP_DATABASE_REPLICA_URL=
APP_REDIS_URL=redis://localhost:6389

# better-auth. the secret is required and at least 32 chars: openssl rand -hex 32.
# BETTER_AUTH_URL is this api; the dashboard origin goes in the trusted origins.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3320
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3020

INNGEST_DEV=1

# the dashboard origin, used for links in email. not BETTER_AUTH_URL, which is
# the api.
APP_URL=http://localhost:3020

# object storage. STORAGE_DRIVER=local writes to ./storage/uploads (gitignored)
# and the api serves it at /uploads, so no credentials are needed to develop.
# tigris needs a bucket and key from the cli; the secret is shown once and
# belongs in .env only, never in git.
STORAGE_DRIVER=tigris
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_ENDPOINT=https://t3.storage.dev
TIGRIS_STORAGE_BUCKET=
# local driver only
STORAGE_LOCAL_DIR=
STORAGE_PUBLIC_URL=

# transactional mail. MAIL_TRANSPORT=log prints the message instead of sending
# it, so the app runs without a provider account; resend then needs no key.
# MAIL_FROM defaults to resend's sandbox sender, which only delivers to your own
# resend account address — set a verified domain to reach anyone else.
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=

# the assistant (mastra + anthropic). MASTRA_TELEMETRY_DISABLED keeps mastra
# from phoning home; the key belongs in .env only, never in git.
ANTHROPIC_API_KEY=
MASTRA_TELEMETRY_DISABLED=1
