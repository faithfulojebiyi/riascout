NODE_ENV=development
PORT=3320
API_PREFIX=

# comma-separated. credentialed cors allowlist — never a wildcard
TRUSTED_ORIGINS=http://localhost:3020

# ?schema=app so prisma's default and raw-query default land in the app schema
APP_DATABASE_URL=postgresql://faithful@localhost:5432/riascout?schema=app
# APP_DATABASE_REPLICA_URL=
APP_REDIS_URL=redis://localhost:6379

INNGEST_DEV=1

# the dashboard origin, used for links in email. not BETTER_AUTH_URL, which is
# the api.
APP_URL=http://localhost:3020

# object storage. create the bucket and key with the tigris cli; the secret is
# shown once and belongs in .env only, never in git.
STORAGE_DRIVER=tigris
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_ENDPOINT=https://t3.storage.dev
TIGRIS_STORAGE_BUCKET=

# transactional mail. MAIL_FROM defaults to resend's sandbox sender, which only
# delivers to your own resend account address — set a verified domain to reach
# anyone else.
RESEND_API_KEY=
MAIL_FROM=
