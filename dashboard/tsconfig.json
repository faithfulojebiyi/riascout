{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@riascout-ui/styled-system/*": [
        "./src/ui/styled-system/*"
      ],
      "@riascout-ui/styled-system": [
        "./src/ui/styled-system"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "orval.config.ts"
  ],
  "exclude": [
    "src/ui/styled-system",
    "node_modules"
  ]
}