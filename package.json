{
  "name": "riascout",
  "version": "0.0.1",
  "description": "Recruiting CRM for RIAs",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "tsc -b && bun run build:aliases",
    "build:api": "tsc -b apps/api/tsconfig.app.json && tsc-alias -p apps/api/tsconfig.app.json",
    "build:worker": "tsc -b apps/worker/tsconfig.app.json && tsc-alias -p apps/worker/tsconfig.app.json",
    "start:dev:api": "lsof -ti:3320 -sTCP:LISTEN | xargs kill -9 2>/dev/null; bun --watch apps/api/src/main.ts",
    "start:dev:worker": "lsof -ti:3321 -sTCP:LISTEN | xargs kill -9 2>/dev/null; bun --watch apps/worker/src/main.ts",
    "start:prod:api": "node dist/apps/api/apps/api/src/main.js",
    "start:prod:worker": "node dist/apps/worker/apps/worker/src/main.js",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint apps libs etl && bun run lint:boundaries",
    "lint:boundaries": "depcruise apps libs --config .dependency-cruiser.cjs",
    "format": "prettier --write \"{apps,libs,etl}/**/*.ts\" \"dashboard/src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "gen": "plop",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "inngest:dev": "npx --ignore-scripts=false inngest-cli@latest dev",
    "prisma:generate": "prisma generate --sql",
    "prisma:draft": "prisma migrate dev --create-only",
    "db:ddl": "bun prisma/apply-ddl.ts",
    "db:ddl:sync": "bun prisma/sync-ddl.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:reset": "prisma migrate reset",
    "build:aliases": "tsc-alias -p apps/api/tsconfig.app.json && tsc-alias -p apps/worker/tsconfig.app.json",
    "prisma:seed": "bun prisma/seed/dimensions.ts",
    "prisma:provision": "bun prisma/seed/provision.ts",
    "api:generate": "cd dashboard && bun run api:generate"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "fastify": "5.12.1",
    "inngest": "4.7.0",
    "joi": "^18.0.2",
    "lexorank": "^1.0.5",
    "nestjs-cls": "^6.2.0",
    "nestjs-zod": "5.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^17.0.0",
    "oxlint": "^1.58.0",
    "plop": "^4.0.4",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "zod": "4.3.6"
  }
}
