{
  "name": "riascout",
  "version": "0.0.1",
  "description": "Recruiting CRM for RIAs",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "nest build api && nest build worker",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "start:dev:api": "lsof -ti:3320 -sTCP:LISTEN | xargs kill -9 2>/dev/null; nest start api --watch",
    "start:dev:worker": "lsof -ti:3321 -sTCP:LISTEN | xargs kill -9 2>/dev/null; nest start worker --watch",
    "start:prod:api": "node dist/apps/api/main",
    "start:prod:worker": "node dist/apps/worker/main",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint apps libs etl && bun run lint:boundaries",
    "lint:boundaries": "depcruise apps libs --config .dependency-cruiser.cjs",
    "format": "prettier --write \"{apps,libs,etl}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "gen": "plop",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "inngest:dev": "npx --ignore-scripts=false inngest-cli@latest dev"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/terminus": "^11.0.0",
    "dotenv": "^17.4.2",
    "fastify": "5.12.1",
    "joi": "^18.0.2",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "5.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^17.0.0",
    "oxlint": "^1.58.0",
    "plop": "^4.0.4",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
