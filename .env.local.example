# Local-only paths and references. Copy to .env.local (gitignored) and fill in.
#
# NAMING RULE: the prior system is referred to in all docs and code only as "the legacy app".
# Its real paths and database names live here and NOWHERE else in the repo.
# See docs/plans/00-overview.md and docs/plans/09-legacy-findings.md.

# Seed data source: the SEC Form ADV / IAPD pipeline (see docs/plans/04-market-etl.md).
# ~10.6 GB, not version-controlled, data/ is gitignored. One-way local seed source.
ASSET_DATA_DIR=/absolute/path/to/asset/data

# Legacy app — reference only. Read for domain field inventory and the defect catalogue.
# Never write these values into docs, comments, commits, or schema.
LEGACY_BACKEND_PATH=
LEGACY_FRONTEND_PATH=
LEGACY_DB_BASE=
LEGACY_DB_NEW=
LEGACY_DB_UPDATED=
