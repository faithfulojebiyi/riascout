# Copy to .env.local (gitignored) and fill in local values.

# canonical SEC/IAPD DuckDB source consumed by etl/load-market.ts
MARKET_DATA_DIR=/absolute/path/to/riascout/market-data/data

# better-auth — generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3320
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3020,http://localhost:3320
