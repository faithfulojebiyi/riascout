{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./",
    "outDir": "./dist/scripts"
  },
  "include": [
    "prisma/**/*.ts",
    "etl/**/*.ts",
    "orm/**/*",
    "libs/**/*.ts",
    "libs/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts"
  ]
}
